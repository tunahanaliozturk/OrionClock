<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionClock.Testing</PackageId>
    <Description>Testing companion for OrionClock: a controllable FakeOrionClock whose time only moves when you Advance or SetUtcNow it, so TTL expiry, deadlines, and timer-driven cancellation fire deterministically without real delays. Built on Microsoft's FakeTimeProvider, so advancing it fires the timers created through it.</Description>
    <PackageTags>orion;time;clock;testing;timeprovider;deterministic;dotnet</PackageTags>
    <RootNamespace>Moongazing.OrionClock.Testing</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Moongazing.OrionClock\Moongazing.OrionClock.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="docs/README.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
